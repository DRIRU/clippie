# Barebone mode (SQLite + local storage + in-process workers). All values optional.
FRAGFORGE_DATA_DIR=./data
# FRAGFORGE_DATABASE_URL=sqlite:///./data/fragforge.db
FRAGFORGE_STORAGE_BACKEND=local
FRAGFORGE_MAX_WORKERS=2
FRAGFORGE_CANDIDATE_PADDING_BEFORE=8
FRAGFORGE_CANDIDATE_PADDING_AFTER=12
FRAGFORGE_MAX_UPLOAD_GB=20
FRAGFORGE_MAX_DURATION_HOURS=6
FRAGFORGE_USE_NVENC=false
