# Barebone mode (SQLite + local storage + in-process workers). All values optional.
CLIPPIE_DATA_DIR=./data
# CLIPPIE_DATABASE_URL=sqlite:///./data/clippie.db
CLIPPIE_STORAGE_BACKEND=local
CLIPPIE_MAX_WORKERS=2
CLIPPIE_CANDIDATE_PADDING_BEFORE=8
CLIPPIE_CANDIDATE_PADDING_AFTER=12
CLIPPIE_MAX_UPLOAD_GB=20
CLIPPIE_MAX_DURATION_HOURS=6
CLIPPIE_USE_NVENC=false
