# Barebone mode (SQLite + local storage + in-process workers). All values optional.
CLIPPIE_DATA_DIR=./data
# CLIPPIE_DATABASE_URL=sqlite:///./data/clippie.db
CLIPPIE_STORAGE_BACKEND=local
CLIPPIE_MAX_WORKERS=2
CLIPPIE_CANDIDATE_PADDING_BEFORE=8
CLIPPIE_CANDIDATE_PADDING_AFTER=12
CLIPPIE_MAX_UPLOAD_GB=20
CLIPPIE_MAX_DURATION_HOURS=6
CLIPPIE_USE_NVENC=false

# Optional AI verification via an existing OpenAI-compatible vision endpoint (off when unset)
# CLIPPIE_VLM_BASE_URL=http://127.0.0.1:8000/v1
# CLIPPIE_VLM_MODEL=
# CLIPPIE_VLM_FRAMES=6
# CLIPPIE_VLM_MAX_IMAGES=4
# CLIPPIE_AUTO_VERIFY=true

# Subtitles (local faster-whisper; the model downloads on first use)
# CLIPPIE_WHISPER_MODEL=base
# CLIPPIE_WHISPER_DEVICE=auto
# CLIPPIE_WHISPER_LANGUAGE=
# CLIPPIE_AUTO_CAPTIONS=false

# Vertical exports: cap the frame rate of fast (e.g. 60 fps) sources; 0 keeps the source rate
# CLIPPIE_VERTICAL_MAX_FPS=30
